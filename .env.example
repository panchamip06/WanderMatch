# WanderMatch Environment Configuration
# PS-11 Problem Statement - KogniVera Hackathon 2026

# Environment
ENV=development
DEBUG=True

# Database (PostgreSQL is system of record; defaults to local PS-11.db SQLite for local dev)
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/travel
# For SQLite dev: sqlite+aiosqlite:///e:/College/Sem5/WanderMatch/WanderMatch/data/PS-11.db
DATABASE_URL=sqlite+aiosqlite:///e:/College/Sem5/WanderMatch/WanderMatch/data/PS-11.db
SYNC_DATABASE_URL=sqlite:///e:/College/Sem5/WanderMatch/WanderMatch/data/PS-11.db

# FastAPI Single Orchestrator
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Firebase Auth (Identity Only)
FIREBASE_PROJECT_ID=wandermatch-ps11
FIREBASE_CREDENTIALS_PATH=
# Set to true for local testing without live Firebase service account JSON
FIREBASE_AUTH_MOCK=True

# Cloudinary (Photo Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Hosted LLM API (Consensus & Branching)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
